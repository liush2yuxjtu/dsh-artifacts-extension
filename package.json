{
  "name": "@local/dsh-artifacts",
  "version": "0.1.3",
  "private": true,
  "description": "DeepSeek Harness (DSH) local multi-type artifacts workbench, version history, reviewable Agent edits and exports; preserves the HTML library.",
  "license": "MIT",
  "author": "Liu Shiyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liush2yuxjtu/dsh-artifacts-extension.git"
  },
  "homepage": "https://github.com/liush2yuxjtu/dsh-artifacts-extension#readme",
  "bugs": {
    "url": "https://github.com/liush2yuxjtu/dsh-artifacts-extension/issues"
  },
  "keywords": [
    "dsh",
    "dsh-extension",
    "dsh-plugin",
    "artifacts",
    "artifact-store",
    "sidebar",
    "slash-commands",
    "deepseek-harness",
    "dsh-plugins"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "workbench/*.js",
    "workbench/*.css",
    "workbench/*.html",
    "scripts/workspace.mjs",
    "docs/workbench.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.zh-CN.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify:legacy": "node skills/verify-dsh-artifacts/scripts/verify.mjs --static-only",
    "dev": "node scripts/dev-workbench.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
